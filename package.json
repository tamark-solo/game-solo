{
  "name": "tien-nghich-preview",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets": "node scripts/sync-preview-assets.mjs && tsx scripts/build-hang-nhac-runtime.ts && node scripts/sync-r01-vfx.mjs",
    "dev": "npm run assets && concurrently -k -n SERVER,CLIENT npm:dev:server npm:dev:client",
    "dev:client": "vite --config vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run assets && npm run typecheck && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "start:server": "tsx server/src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:online": "tsx tests/online-smoke.ts",
    "test:hang-nhac": "tsx tests/hang-nhac-online-smoke.ts && node tests/hang-nhac-browser-smoke.mjs",
    "test:hang-nhac-r01": "tsx tests/hang-nhac-r01-online-smoke.ts && node tests/hang-nhac-r01-browser-smoke.mjs",
    "test:skill-animation": "tsx tests/hang-nhac-skill-animation-smoke.ts",
    "test:skill-aim": "tsx tests/hang-nhac-skill-input-online-smoke.ts && tsx tests/hang-nhac-skill-aim-smoke.mjs",
    "test:skill-vfx": "node tests/skill-vfx-render-smoke.mjs",
    "test:skill-body": "node tests/skill-body-render-smoke.mjs",
    "test:hang-nhac-sect": "tsx tests/hang-nhac-sect-online-smoke.ts && tsx tests/hang-nhac-sect-browser-smoke.ts",
    "test:hang-nhac-reload": "tsx tests/hang-nhac-reload-interaction-smoke.ts",
    "test:browser": "node tests/browser-smoke.mjs",
    "test:movement": "node tests/movement-smoke.mjs",
    "test:gait-review": "node tests/gait-review-smoke.mjs",
    "test:chibi-pilot": "node tests/chibi-pilot-smoke.mjs",
    "test:starter-region": "node tests/starter-region-smoke.mjs",
    "test:map-editor": "node tests/map-editor-smoke.mjs",
    "test:level-design": "node tests/level-design-smoke.mjs",
    "test:map-studio": "node tests/map-studio-smoke.mjs",
    "test:map-spline": "node tests/map-spline-smoke.mjs",
    "test:map-cut": "node tests/map-cut-smoke.mjs",
    "test:map-navigation": "node tests/map-navigation-smoke.mjs",
    "test:map-asset-backup": "node tests/map-asset-backup-smoke.mjs"
  },
  "dependencies": {
    "@colyseus/schema": "5.0.36",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "colyseus": "0.18.9",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "concurrently": "10.0.5",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
