  "anatomyProxyFile": "actors/a/sword/anatomy-measurements.json",
  "comparisonFile": "actors/a/sword/comparison.json",
  "manualProofFile": "actors/a/sword/manual-proof.json",
  "groundImports": "actors/a/sword/ground-imports.json",
  "limitationsAndDeltas": [
    {
      "kind": "identity",
      "detail": "Own approved A has a slimmer torso and smaller head than Wang. Preserve own face/hair/cream-black Sword coat and gold trim; Wang only establishes native anatomy/style/camera reference. An80px crown-to-boot number does not prove anatomy."
    },
    {
      "kind": "source-history",
      "detail": "Nine failed/unused raw sources, prompts and immutable inputs retained. Source bottom clipping, touching cells, wrong left camera, compressed cast heads or missing AOE heads are not used as active canonical artwork."
    },
    {
      "kind": "row-count",
      "detail": "South locomotion r3 requested text contained an18/30-body conflict; actual selected output has30 complete bodies in6columns5rows, used as six neutral+fouractions. SE practice contains15 actual bodies, so meditate has three genuine keys. No fabricated keys fill either layout."
    },
    {
      "kind": "run",
      "detail": "East/South source sixth run keys are neutral standing recoveries, excluded from loop; five actual stride keys retained. South run1 uses open palm and run3 joins a seal during stride, so both detach-hover and retain actual choreography rather than claim a held grip."
    },
    {
      "kind": "gather",
      "detail": "NE/NW/S/SW/W final source gather is a low stance, so each appends an actual same-source neutral calibration0 as a seventh160ms standing recovery. Raw six action keys are kept. These are five reuse keys, not five new generated poses/calibrations."
    },
    {
      "kind": "head-measurement",
      "detail": "anatomy-measurements.json reports per-pose fixed head/hair band and warm-face proxies. Hair flare during run and whole prone bodies make band width grow; a tiny rear cheek changes1–4 pixels by angle/occlusion. These are diagnostic values, not skull/bone dimensions or blanket anatomy approval. Standing recoveries retain own head/torso mass visibly; rear cheek deltas up to33.33% and NE idle hair-band10.81% remain reported."
    },
    {
      "kind": "grip",
      "detail": "All336 new keys have actual raw-coordinate palm or explicitly hidden cuff/forearm endpoint and visual source/native proof. Color islands were only candidate locations; belt/cuff false positives were corrected on original raw. N meditate uses six hidden cuff endpoints; NE meditate fingertips and NW run3 fragment remain honest. Cast/meditate/gather open/seal hands use hover/stow rather than a forced held blade."
    },
    {
      "kind": "wrist",
      "detail": "100 core idle/run/recovery/source cuffs measured relative actual same-direction own neutral calibration (52 new E/NE/S/SW plus48 W/NW). Each projects a short bracer-to-palm vector with ±1nativepixel and explicit angle uncertainty; no N135/facing rotation. Foundation/other detached keys have unmeasured0 presentation placeholder, not a claimed wrist measurement."
    },
    {
      "kind": "root",
      "detail": "Run uses per-key cloth-waist/upper-leg projection onto a measured row ground, preserving natural foot lift without lowest-sole horizontal wobble. Death uses160x112/(80,104) padding; support boot/knee for first two keys, clothed pelvis/upper-thigh projection and observed corpse material contact thereafter. Seated meditation uses folded legs/robe support. Actual per-axis uncertainty spans1–6nativepixels across boot support and concealed waist candidates; sourceProof records the specific bound rather than a false exact pelvis claim."
    },
    {
      "kind": "lift",
      "detail": "The3px death key3 lift is a presentation candidate already encoded in canonical source-root translation; lift metadata explains it. Transparent source has no actual world floor. Renderer must not subtract lift again from body."
    },
    {
      "kind": "motion",
      "detail": "Raw head/view/gesture coverage and source/canonical/atlas QA are complete; no animation rig guarantees anatomical handedness through every perspective. Browser/GPU and gear/FX overlay checks are root review steps, not claimed by this body worker."
    },
    {
      "kind": "approval",
      "detail": "Eight approved V1 body clips/49 keys stay byte-for-byte unchanged and are only referenced. New56clips/336keys remain candidate ART/motion; no runtime/map/navigation/DB or gameplay integration was made."
    }
  ],
