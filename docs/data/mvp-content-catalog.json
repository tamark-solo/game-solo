  "storyScenes": [
    {
      "id": "E01-VILLAGE",
      "eventId": "E01",
      "locationId": "MAP-001",
      "title": "Kỳ vọng của gia đình",
      "characterPresentationVariantKey": "mortal_clothes",
      "sourceRefs": [
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-1"
      ],
      "presentationAssetRefs": [
        "AS-ENV-001",
        "AS-CHR-001",
        "AS-CHR-002",
        "AS-CHR-003"
      ],
      "segments": [
        {
          "id": "E01-VILLAGE-S1",
          "text": "Vương Lâm lớn lên trong một gia đình bình thường. Cơ hội bước vào con đường tu tiên mang theo niềm hy vọng của cha mẹ."
        },
        {
          "id": "E01-VILLAGE-S2",
          "text": "Nhờ cơ hội được tứ thúc đem tới, Vương Lâm lên đường tới Hằng Nhạc phái. Hành trình bắt đầu bằng các khảo nghiệm tuyển chọn."
        }
      ]
    },
    {
      "id": "E02-EXAM",
      "eventId": "E02",
      "locationId": "MAP-002",
      "encounterId": "ENC-003",
      "title": "Khảo nghiệm Hằng Nhạc",
      "characterPresentationVariantKey": "mortal_clothes",
      "sourceRefs": [
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-3",
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-4"
      ],
      "presentationAssetRefs": [
        "AS-ENV-004",
        "AS-CHR-001",
        "AS-CHR-004"
      ],
      "segments": [
        {
          "id": "E02-EXAM-S1",
          "text": "Vương Lâm cùng những người dự tuyển đến khu khảo nghiệm. Vương Trác cũng có mặt trong dịp tuyển chọn này."
        },
        {
          "id": "E02-EXAM-S2",
          "text": "Kết quả khảo nghiệm tư chất không đem lại cơ hội nhập môn cho Vương Lâm. Mong muốn tu tiên gặp trở ngại ngay từ bước đầu."
        },
        {
          "id": "E02-EXAM-S3",
          "text": "Thử thách tiếp theo dưới áp lực kiếm linh cũng không thành công. Vương Lâm phải rời đi, nhưng hành trình tìm đường tu tiên vẫn chưa kết thúc."
        }
      ]
    },
    {
      "id": "E03-TRAIL",
      "eventId": "E03",
      "locationId": "MAP-003",
      "encounterId": "ENC-001",
      "title": "Nguy hiểm trên đường núi",
      "characterPresentationVariantKey": "mortal_clothes",
      "sourceRefs": [
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-7"
      ],
      "presentationAssetRefs": [
        "AS-ENV-002",
        "AS-CHR-001",
        "AS-CRE-001"
      ],
      "segments": [
        {
          "id": "E03-TRAIL-S1",
          "text": "Trên đường núi trở lại tìm cơ hội, Vương Lâm gặp một con hổ trắng có đôi mắt đỏ. Nguy hiểm buộc hắn phải tìm đường thoát."
        },
        {
          "id": "E03-TRAIL-S2",
          "text": "Biến cố thoát hiểm dẫn Vương Lâm tới khu vực vách núi. Một hang đá trở thành nơi tiếp theo trong hành trình."
        }
      ]
    },
    {
      "id": "E03-CAVE",
      "eventId": "E03",
      "locationId": "MAP-004",
      "encounterId": "ENC-002",
      "title": "Hạt châu trong hang",
      "characterPresentationVariantKey": "mortal_clothes",
      "sourceRefs": [
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-8"
      ],
      "presentationAssetRefs": [
        "AS-ENV-003",
        "AS-CHR-001",
        "AS-ICO-004"
      ],
      "segments": [
        {
          "id": "E03-CAVE-S1",
          "text": "Trong hang có một lực hút xuất hiện theo đợt. Vương Lâm quan sát dấu tích và sự bất thường để tìm hiểu nơi này."
        },
        {
          "id": "E03-CAVE-S2",
          "text": "Giữa những dấu tích trong hang, hắn có được một hạt châu xám với năm đám mây. Công dụng và lai lịch của vật này vẫn là điều chưa biết.",
          "beadPresentationVariantKey": "five_clouds"
        }
      ]
    },
    {
      "id": "E04-DORM",
      "eventId": "E04",
      "locationId": "MAP-005",
      "title": "Đệ tử ký danh",
      "characterPresentationVariantKey": "gray_clothes",
      "sourceRefs": [
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-10"
      ],
      "presentationAssetRefs": [
        "AS-ENV-005",
        "AS-CHR-001",
        "AS-CHR-005"
      ],
      "segments": [
        {
          "id": "E04-DORM-S1",
          "text": "Sau những biến cố tiếp theo, Vương Lâm có cơ hội vào Hằng Nhạc phái với thân phận đệ tử ký danh, mặc áo xám và ở trong phòng chung."
        },
        {
          "id": "E04-DORM-S2",
          "text": "Cuộc sống trong môn phái bắt đầu bằng các công việc thường ngày. Trương Hổ xuất hiện trong giai đoạn này; việc lấy nước trở thành một phần sinh hoạt của Vương Lâm."
        }
      ]
    },
    {
      "id": "E04-SPRING",
      "eventId": "E04",
      "locationId": "MAP-006",
      "title": "Nước và hạt châu",
      "characterPresentationVariantKey": "gray_clothes",
      "sourceRefs": [
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-11",
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-14"
      ],
      "presentationAssetRefs": [
        "AS-ENV-002",
        "AS-CHR-001",
        "AS-ICO-004",
        "AS-ICO-005"
      ],
      "segments": [
        {
          "id": "E04-SPRING-S1",
          "text": "Vương Lâm đến nguồn nước trong núi để làm công việc được giao. Nước suối là bước đầu của chuỗi chuẩn bị.",
          "beadPresentationVariantKey": "five_clouds"
        },
        {
          "id": "E04-SPRING-S2",
          "text": "Nước tiếp xúc với hạt châu bộc lộ tác dụng khác thường. Phần nước chứa linh khí này được gọi ngắn là linh dịch trên bảng tài nguyên.",
          "beadPresentationVariantKey": "five_clouds"
        },
        {
          "id": "E04-SPRING-S3",
          "text": "Những diễn biến trong giai đoạn nhập môn, bao gồm trận giông, khiến hoa văn trên hạt châu đạt bảy đám mây. Hãy bắt đầu lấy nước rồi chuẩn bị linh dịch để tiếp tục khám phá.",
          "beadPresentationVariantKey": "seven_clouds"
        }
      ]
    },
    {
      "id": "E05-GARDEN",
      "eventId": "E05",
      "locationId": "MAP-007",
      "title": "Nhận công pháp",
      "characterPresentationVariantKey": "gray_clothes",
      "sourceRefs": [
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-16",
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-17"
      ],
      "presentationAssetRefs": [
        "AS-ENV-004",
        "AS-ENV-005",
        "AS-CHR-001",
        "AS-CHR-006",
        "AS-ICO-006"
      ],
      "segments": [
        {
          "id": "E05-GARDEN-S1",
          "text": "Bầu nước khiến Tôn Đại Trụ chú ý tới Vương Lâm. Hắn được nhận làm đệ tử, chuyển sang áo đỏ và có cơ hội học công pháp nhập môn."
        },
        {
          "id": "E05-GARDEN-S2",
          "text": "Phòng ở của đệ tử là nơi thử luyện thổ nạp. Việc tu luyện được tách khỏi luống dược thảo; hãy luyện ba lần để quan sát tiến triển.",
          "characterPresentationVariantKey": "red_clothes"
        }
      ]
    },
    {
      "id": "E06-ROOM",
      "eventId": "E06",
      "locationId": "MAP-008",
      "title": "Giải trừ trở ngại",
      "characterPresentationVariantKey": "red_clothes",
      "sourceRefs": [
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-18",
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-20",
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-22"
      ],
      "presentationAssetRefs": [
        "AS-ENV-005",
        "AS-CHR-001",
        "AS-ICO-004"
      ],
      "segments": [
        {
          "id": "E06-ROOM-S1",
          "text": "Dù đã thử công pháp, Vương Lâm vẫn không giữ được linh khí. Những diễn biến liên quan tới dược liệu làm tán linh khí giải thích trở ngại này."
        },
        {
          "id": "E06-ROOM-S2",
          "text": "Sau khi rời dược viên và lấy lại hạt châu, hắn tiếp tục tìm cách tu luyện trong phòng riêng. Hoa văn trên châu lúc này đã đạt chín đám mây.",
          "beadPresentationVariantKey": "nine_clouds"
        },
        {
          "id": "E06-ROOM-S3",
          "text": "Vương Lâm giải trừ tác động cản trở bằng cách điều chỉnh thổ nạp. Từ mốc này, tu luyện thường bắt đầu giữ lại được tu vi trong game.",
          "beadPresentationVariantKey": "nine_clouds"
        }
      ]
    },
    {
      "id": "E07-DREAM",
      "eventId": "E07",
      "locationId": "MAP-009",
      "title": "Không gian mộng cảnh",
      "characterPresentationVariantKey": "red_clothes",
      "sourceRefs": [
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-23",
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-24"
      ],
      "presentationAssetRefs": [
        "AS-ENV-006",
        "AS-CHR-001",
        "AS-ICO-004"
      ],
      "segments": [
        {
          "id": "E07-DREAM-S1",
          "text": "Hoa văn đạt mười đám mây rồi biến mất, để lộ những dấu trên hạt châu. Đây là bước chuyển dẫn tới khả năng khám phá mộng cảnh.",
          "beadPresentationVariantKey": "ten_clouds_transition"
        },
        {
          "id": "E07-DREAM-S2",
          "text": "Trong không gian mộng cảnh, thời gian dài gấp mười lần bên ngoài. Vương Lâm có thêm thời gian cho việc tu luyện.",
          "beadPresentationVariantKey": "inscribed"
        },
        {
          "id": "E07-DREAM-S3",
          "text": "Mộng cảnh không có linh khí tự nhiên để sử dụng tùy ý. Linh dịch được dùng để chuẩn bị trước khi vào; từ đây có thể chọn mộng cảnh hoặc bật chuỗi chuẩn bị tự động.",
          "beadPresentationVariantKey": "inscribed"
        }
      ]
    },
    {
      "id": "E08-BREAKTHROUGH",
      "eventId": "E08",
      "locationId": "MAP-008",
      "title": "Chuẩn bị đột phá",
      "characterPresentationVariantKey": "red_clothes",
      "sourceRefs": [
        "https://www.wuxiaworld.com/novel/renegade-immortal/rge-chapter-25"
      ],
      "presentationAssetRefs": [
        "AS-ENV-005",
        "AS-CHR-001",
        "AS-ICO-003"
      ],
      "segments": [
        {
          "id": "E08-BREAKTHROUGH-S1",
          "text": "Qua quá trình chuẩn bị và tu luyện, Vương Lâm đã tích lũy đủ tu vi cho tầng đầu. Hoàn tất đột phá để bước từ phàm nhân vào Ngưng Khí tầng 1."
        }
      ]
    }
  ],
